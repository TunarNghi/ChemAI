# 1. Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Next.js Client-Side Prefixes (Bắt buộc cho trình duyệt Client Components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# 2. Supabase Backup Database (Dự phòng Failover)
NEXT_PUBLIC_BACKUP_SUPABASE_URL=https://your-backup-project.supabase.co
NEXT_PUBLIC_BACKUP_SUPABASE_ANON_KEY=your-backup-anon-key

# 3. Dify AI Gateway (Soạn Kế hoạch bài dạy chuẩn Công văn 5512 BGD&ĐT)
NEXT_PUBLIC_DIFY_API_URL=https://api.dify.ai/v1
NEXT_PUBLIC_DIFY_API_KEY=your-dify-api-key

# 4. Google Gemini AI Engine (Gia sư AI IUPAC, Thí nghiệm ảo, Đấu trường Kahoot, Đề thi 2025)
NEXT_PUBLIC_GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# 5. Teacher Audit Portal Password (Cổng kiểm duyệt dành cho Giáo viên)
NEXT_PUBLIC_TEACHER_AUDIT_PASSWORD=chemai2026
